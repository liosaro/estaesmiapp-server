# Copia este archivo a .env para desarrollo local (en Render se configuran
# estas mismas variables en Dashboard -> Environment, nunca se sube el .env real).

PORT=4000

# CORS: dominio del sitio y esquema de la app (deja * en desarrollo)
CORS_ORIGIN=*

# --- Spotify Developer (https://developer.spotify.com/dashboard) ---
# Client Credentials flow: solo necesitamos leer contenido publico
# (episodios de podcast, playlists), no login de usuarios.
SPOTIFY_CLIENT_ID=tu_client_id_aqui
SPOTIFY_CLIENT_SECRET=tu_client_secret_aqui

# IDs de Spotify a exponer en la app (los mismos que ya usa el sitio web)
SPOTIFY_SHOW_ID=id_del_podcast_astrid_cordoba
SPOTIFY_PLAYLIST_PRINCIPAL_ID=id_playlist_principal_del_canal
SPOTIFY_PLAYLIST_SPONSOR_ID=id_playlist_sponsor

# --- YouTube Data API v3 (https://console.cloud.google.com) ---
YOUTUBE_API_KEY=tu_api_key_de_youtube
YOUTUBE_CHANNEL_ID=id_del_canal_de_youtube

# --- Radio 24/7 (mismo stream que ya usa el sitio, puerto 8008) ---
RADIO_STREAM_URL=http://tu-servidor-fasthost:8008/stream
RADIO_STATUS_URL=http://tu-servidor-fasthost:8008/status-json.xsl

# --- Cabina en vivo (stream interactivo + chat) ---
LIVE_EMBED_URL=https://estaesmiapp.com/vivo
LIVE_CHAT_EMBED_URL=https://estaesmiapp.com/vivo/chat
